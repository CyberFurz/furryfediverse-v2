// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime? 
  sessions      Session[]
  accounts      Account[]
  instances     Instance[]
  articles      Article[]
  articleDrafts ArticleDraft[]
  linkedProfiles     LinkedProfile[]
  starterPacks       StarterPack[]
  starterPackAccounts StarterPackAccount[]
  followAllClicks    FollowAllClick[]

  @@unique([email])
  @@map("user")
}

model LinkedProfile {
  id                String                @id @default(cuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform          String
  instanceDomain    String
  externalAccountId String
  accessToken       String
  refreshToken      String?
  tokenExpiresAt    DateTime?
  scope             String
  username          String
  acct              String
  displayName       String?
  avatarUrl         String?
  headerUrl         String?
  bio               String?
  followersCount    Int                   @default(0)
  followingCount    Int                   @default(0)
  statusesCount     Int                   @default(0)
  profileUrl        String?
  customEmojiMap    Json?
  customEmojiUpdatedAt DateTime?
  lastSyncedAt      DateTime?
  syncError         String?
  isActive          Boolean               @default(true)
  isPrimaryNsfw     Boolean               @default(false)
  isPrimaryProfile  Boolean               @default(false)
  hashtags          LinkedProfileHashtag[]
  starterPackAccounts StarterPackAccount[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([platform, instanceDomain, externalAccountId])
  @@index([userId])
  @@index([platform])
  @@index([acct])
  @@map("linked_profile")
}

model LinkedProfileHashtag {
  id              String        @id @default(cuid())
  linkedProfileId String
  linkedProfile   LinkedProfile @relation(fields: [linkedProfileId], references: [id], onDelete: Cascade)
  tag             String
  normalizedTag   String
  createdAt       DateTime      @default(now())

  @@unique([linkedProfileId, normalizedTag])
  @@index([normalizedTag])
  @@index([linkedProfileId])
  @@map("linked_profile_hashtag")
}

model AuthFlowState {
  id         String   @id @default(cuid())
  state      String   @unique
  kind       String
  payload    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([kind])
  @@index([expiresAt])
  @@map("auth_flow_state")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  impersonatedBy String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Instance {
  id               String   @id @default(cuid())
  domain           String   // e.g. "mastodon.social"
  instanceType     String   // "mastodon", "misskey", "funkwhale"
  title            String
  description      String
  thumbnail        String?
  thumbnailPath    String?  // Local cached path
  userCount        Int      @default(0)
  instanceContact  String?
  registrations    Boolean  @default(false)
  approvalRequired Boolean  @default(false)
  nsfwAllowed      Boolean  @default(false)
  country          String?
  primaryLanguage  String?
  donationLink     String?
  customInviteLink String?
  addedByUserId    String
  addedBy          User     @relation(fields: [addedByUserId], references: [id], onDelete: Cascade)
  verified         Boolean  @default(false)
  verificationKey  InstanceApiKey?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([domain])
  @@index([addedByUserId])
  @@map("instance")
}

model InstanceApiKey {
  id         String   @id @default(cuid())
  apiKey     String   @unique
  instanceId String   @unique
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  used       Boolean  @default(false)
  expiresAt  DateTime

  @@index([apiKey])
  @@map("instance_api_key")
}

model Article {
  id         String         @id @default(cuid())
  title      String
  content    String
  category   String         // "self-hosting", "how-to", "other"
  authorId   String
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  drafts     ArticleDraft[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([authorId])
  @@index([category])
  @@map("article")
}

model ArticleDraft {
  id         String   @id @default(cuid())
  articleId  String?  // null for new submissions, set when linked to published article
  article    Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  title      String
  content    String
  category   String   // "self-hosting", "how-to", "other"
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  status     String   @default("pending") // "draft", "pending", "approved", "rejected"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([authorId])
  @@index([articleId])
  @@index([status])
  @@map("article_draft")
}

model StarterPack {
  id                    String   @id @default(cuid())
  title                 String
  slug                  String
  description           String
  createdById           String
  createdBy             User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?
  status                String   @default("draft")
  submittedAt           DateTime?
  publishedAt           DateTime?
  numAccounts           Int      @default(0)

  accounts    StarterPackAccount[]
  followClicks FollowAllClick[]

  @@unique([createdById, slug])
  @@index([status])
  @@index([publishedAt])
  @@index([deletedAt])
  @@map("starter_pack")
}

model StarterPackAccount {
  id              String         @id @default(cuid())
  starterPackId   String
  starterPack     StarterPack    @relation(fields: [starterPackId], references: [id], onDelete: Cascade)
  linkedProfileId String?
  linkedProfile   LinkedProfile? @relation(fields: [linkedProfileId], references: [id])
  handle          String?
  createdAt       DateTime       @default(now())
  createdById     String
  createdBy       User           @relation(fields: [createdById], references: [id])

  @@unique([starterPackId, linkedProfileId])
  @@index([starterPackId])
  @@map("starter_pack_account")
}

model FollowAllClick {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  starterPackId String
  starterPack   StarterPack @relation(fields: [starterPackId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([starterPackId, createdAt])
  @@map("follow_all_click")
}
