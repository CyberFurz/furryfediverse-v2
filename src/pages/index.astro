---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
---

<Layout title="Furry Fediverse">
	<!-- Hero Section -->
	<main class="p-2 md:p-5 lg:px-60 2xl:px-80">
		<div class="text-center py-10">
			<div class="flex justify-center mb-4">
				<img
					src="/images/FullColor.webp"
					alt="Furry Fediverse Logo"
					class="w-180 h-62"
				/>
			</div>
			<h1 class="text-5xl md:text-6xl font-bold mb-6 text-white">
				Welcome to the <span class="text-[#31dcb2]"
					>Furry Fediverse</span
				>
			</h1>
			<p class="text-xl text-white/80 max-w-2xl mx-auto mb-10">
				Own your furry space online: community-run servers by real
				furries, federating via ActivityPub. No corporate overlords,
				just furries operating and maintaining their own personal &amp;
				community servers.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a
					href="/instances"
					class="bg-[#31dcb2] text-[#12384b] font-semibold px-8 py-3 rounded-lg hover:bg-[#28c4a0] transition-colors no-underline"
				>
					Join the Fediverse
				</a>
				<a
					href="/learn"
					class="bg-white/10 text-white font-semibold px-8 py-3 rounded-lg hover:bg-white/20 transition-colors border border-white/20 no-underline"
				>
					Learn More
				</a>
			</div>
		</div>

		<!-- Features Section -->
		<div class="py-16">
			<h2 class="text-3xl font-bold text-center text-white mb-12">
				Why the Furry Fediverse?
			</h2>
			<div
				class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto"
			>
				<div class="bg-white/5 rounded-xl p-6 border border-white/10">
					<div class="flex items-start gap-4">
						<div class="shrink-0">
							<svg
								class="w-8 h-8 text-[#31dcb2]"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"
								></path>
							</svg>
						</div>
						<div>
							<h3 class="text-xl font-bold text-white mb-2">
								Self-Hostable
							</h3>
							<p class="text-white/70">
								Run your own instance with complete control over
								your community, rules, and content. No
								dependencies on third-party platforms.
							</p>
						</div>
					</div>
				</div>

				<div class="bg-white/5 rounded-xl p-6 border border-white/10">
					<div class="flex items-start gap-4">
						<div class="shrink-0">
							<svg
								class="w-8 h-8 text-[#31dcb2]"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
								></path>
							</svg>
						</div>
						<div>
							<h3 class="text-xl font-bold text-white mb-2">
								Federated Networks
							</h3>
							<p class="text-white/70">
								Mastodon for microblogging, Pixelfed for photos,
								and more—all communicating via ActivityPub. One
								protocol, endless possibilities.
							</p>
						</div>
					</div>
				</div>

				<div class="bg-white/5 rounded-xl p-6 border border-white/10">
					<div class="flex items-start gap-4">
						<div class="shrink-0">
							<svg
								class="w-8 h-8 text-[#31dcb2]"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
								></path>
							</svg>
						</div>
						<div>
							<h3 class="text-xl font-bold text-white mb-2">
								Own Your Data
							</h3>
							<p class="text-white/70">
								Your posts, media, and identity live on your
								server—not in a corporate database. Export,
								migrate, or back up whenever you want.
							</p>
						</div>
					</div>
				</div>

				<div class="bg-white/5 rounded-xl p-6 border border-white/10">
					<div class="flex items-start gap-4">
						<div class="shrink-0">
							<svg
								class="w-8 h-8 text-[#31dcb2]"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
								></path>
							</svg>
						</div>
						<div>
							<h3 class="text-xl font-bold text-white mb-2">
								User Directory <span
									class="text-xs bg-[#31dcb2] text-[#12384b] px-2 py-1 rounded ml-1"
									>Beta</span
								>
							</h3>
							<p class="text-white/70">
								Discover furries across the fediverse in one
								place. Search and browse users from different
								instances (currently in beta).
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>
</Layout>
