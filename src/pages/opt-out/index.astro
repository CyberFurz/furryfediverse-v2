---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Opt Out of Starter Packs - Furry Fediverse">
	<main class="p-2 md:p-5 lg:px-60 2xl:px-80">
		<div class="py-8 max-w-2xl mx-auto">
			<h1 class="text-3xl font-bold text-white mb-3">
				Opt out of <span class="text-[#31dcb2]">Starter Packs</span>
			</h1>
			<p class="text-white/70 mb-2">
				Starter packs are lists of accounts that people share to help newcomers find folks to follow.
				If you don't want your fediverse account included in any starter pack on this site, you can opt out here.
				You don't need an account on Furry Fediverse.
			</p>
			<ul class="text-white/60 text-sm list-disc pl-5 space-y-1 mb-6">
				<li>We'll send a direct message to your account from our bot with a confirmation link.</li>
				<li>Once you confirm, your account is removed from every pack and can't be added again.</li>
				<li>If someone else enters your handle, nothing happens unless you confirm.</li>
			</ul>

			<form id="opt-out-form" class="bg-[#0D3559] rounded-xl p-6 border border-white/10 space-y-4">
				<label for="opt-out-handle" class="block text-sm font-medium text-white/80">Your fediverse handle</label>
				<input
					id="opt-out-handle"
					name="handle"
					type="text"
					required
					autocomplete="off"
					autocapitalize="off"
					spellcheck="false"
					placeholder="@name@instance.social"
					maxlength="254"
					class="w-full px-4 py-3 bg-white/5 border border-white/20 rounded-lg text-white placeholder-white/40 focus:outline-none focus:border-[#31dcb2] focus:ring-1 focus:ring-[#31dcb2]"
				/>
				<button
					id="opt-out-submit"
					type="submit"
					class="w-full py-3 bg-[#31dcb2] text-[#12384b] font-semibold rounded-lg hover:bg-[#28c4a0] disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
				>
					Send confirmation message
				</button>
				<div id="opt-out-result" class="hidden p-3 rounded-lg text-sm" role="status" aria-live="polite"></div>
			</form>

			<p class="text-white/40 text-xs mt-4">
				Make sure your account accepts direct messages from accounts you don't follow, or check your
				filtered/requests inbox. Messages come from
				<a href="https://cyberfurz.social/@furryfediverse" target="_blank" rel="noopener noreferrer" class="text-[#31dcb2]">@furryfediverse@cyberfurz.social</a>.
			</p>
		</div>
	</main>
</Layout>

<script>
	const form = document.getElementById("opt-out-form") as HTMLFormElement | null;
	const input = document.getElementById("opt-out-handle") as HTMLInputElement | null;
	const button = document.getElementById("opt-out-submit") as HTMLButtonElement | null;
	const result = document.getElementById("opt-out-result");

	function show(kind: "ok" | "error", text: string) {
		if (!result) return;
		result.textContent = text;
		result.className = `p-3 rounded-lg text-sm border ${
			kind === "ok"
				? "bg-emerald-500/10 border-emerald-500/30 text-emerald-300"
				: "bg-red-500/10 border-red-500/30 text-red-300"
		}`;
	}

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();
		if (!input || !button) return;
		button.disabled = true;
		button.textContent = "Sending...";
		try {
			const res = await fetch("/api/opt-out", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ handle: input.value }),
			});
			const data = await res.json().catch(() => ({}));
			if (!res.ok) throw new Error(data.error || "Something went wrong");
			show("ok", data.message);
		} catch (err) {
			show("error", err instanceof Error ? err.message : "Something went wrong");
		} finally {
			button.disabled = false;
			button.textContent = "Send confirmation message";
		}
	});
</script>
