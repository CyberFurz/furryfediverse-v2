---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";

const user = Astro.locals.user;

if (!user) {
	return Astro.redirect("/auth/login");
}

const roles = (user.role || "user").split(",");
const isAdmin = roles.includes("admin");
if (!isAdmin) {
	return Astro.redirect("/auth/dashboard");
}

async function getStats() {
	try {
		const usersRes = await fetch(`${process.env.BETTER_AUTH_URL || "http://localhost:4321"}/api/auth/admin/list-users?limit=1&sortBy=createdAt&sortDirection=desc`, {
			headers: Astro.request.headers,
		});
		const usersData = await usersRes.json().catch(() => null);

		const { prisma } = await import("../../lib/prisma");
		const [
			totalInstances, unverifiedInstances, pollingInstances,
			pendingEvents, totalEvents,
			pendingPacks, totalPacks,
			pendingArticles, totalArticles,
			totalUsersCount,
		] = await Promise.all([
			prisma.instance.count(),
			prisma.instance.count({ where: { verified: false } }),
			prisma.instance.count({ where: { pollingAllowed: true } }),
			prisma.event.count({ where: { status: "pending" } }),
			prisma.event.count(),
			prisma.starterPack.count({ where: { status: "pending", deletedAt: null } }),
			prisma.starterPack.count({ where: { deletedAt: null } }),
			prisma.articleDraft.count({ where: { status: "pending" } }),
			prisma.articleDraft.count(),
			prisma.user.count(),
		]);

		return {
			totalUsers: totalUsersCount,
			totalInstances,
			unverifiedInstances,
			pollingInstances,
			pendingEvents,
			totalEvents,
			pendingPacks,
			totalPacks,
			pendingArticles,
			totalArticles,
		};
	} catch {
		return { totalUsers: 0, totalInstances: 0, unverifiedInstances: 0, pollingInstances: 0, pendingEvents: 0, totalEvents: 0, pendingPacks: 0, totalPacks: 0, pendingArticles: 0, totalArticles: 0 };
	}
}

const stats = await getStats();
---

<Layout title="Admin Dashboard - Furry Fediverse">
	<main class="p-2 md:p-5 lg:px-60 2xl:px-80">
		<div class="py-8">
			<h1 class="text-3xl font-bold text-white mb-8">
				Admin <span class="text-[#31dcb2]">Dashboard</span>
			</h1>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
				<a href="/admin/users" class="bg-[#0D3559] rounded-xl p-6 border border-white/10 hover:border-[#31dcb2]/50 transition-colors no-underline block">
					<div class="flex items-center gap-4 mb-3">
						<div class="w-12 h-12 bg-[#31dcb2] rounded-full flex items-center justify-center text-[#12384b]">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
						</div>
						<div>
							<p class="text-white/60 text-sm">Users</p>
							<p class="text-white font-semibold text-2xl">{stats.totalUsers}</p>
						</div>
					</div>
				</a>

				<a href="/admin/instances" class="bg-[#0D3559] rounded-xl p-6 border border-white/10 hover:border-[#31dcb2]/50 transition-colors no-underline block">
					<div class="flex items-center gap-4 mb-3">
						<div class="w-12 h-12 bg-[#31dcb2] rounded-full flex items-center justify-center text-[#12384b]">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>
						</div>
						<div>
							<p class="text-white/60 text-sm">Instances</p>
							<p class="text-white font-semibold text-2xl">{stats.totalInstances}</p>
						</div>
					</div>
					<div class="flex gap-4 text-xs">
						<span class="text-yellow-400/80">{stats.unverifiedInstances} unverified</span>
						<span class="text-[#31dcb2]/80">{stats.pollingInstances} polling</span>
					</div>
				</a>

				<a href="/admin/articles" class="bg-[#0D3559] rounded-xl p-6 border border-white/10 hover:border-[#31dcb2]/50 transition-colors no-underline block">
					<div class="flex items-center gap-4 mb-3">
						<div class="w-12 h-12 bg-[#31dcb2] rounded-full flex items-center justify-center text-[#12384b]">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>
						</div>
						<div>
							<p class="text-white/60 text-sm">Article Reviews</p>
							<p class="text-white font-semibold text-2xl">{stats.totalArticles}</p>
						</div>
					</div>
					<div class="flex gap-4 text-xs">
						<span class="text-amber-400/80">{stats.pendingArticles} pending</span>
					</div>
				</a>

				<a href="/admin/packs" class="bg-[#0D3559] rounded-xl p-6 border border-white/10 hover:border-[#31dcb2]/50 transition-colors no-underline block">
					<div class="flex items-center gap-4 mb-3">
						<div class="w-12 h-12 bg-[#31dcb2] rounded-full flex items-center justify-center text-[#12384b]">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
						</div>
						<div>
							<p class="text-white/60 text-sm">Starter Packs</p>
							<p class="text-white font-semibold text-2xl">{stats.totalPacks}</p>
						</div>
					</div>
					<div class="flex gap-4 text-xs">
						<span class="text-amber-400/80">{stats.pendingPacks} pending</span>
					</div>
				</a>

				<a href="/admin/events" class="bg-[#0D3559] rounded-xl p-6 border border-white/10 hover:border-[#31dcb2]/50 transition-colors no-underline block">
					<div class="flex items-center gap-4 mb-3">
						<div class="w-12 h-12 bg-[#31dcb2] rounded-full flex items-center justify-center text-[#12384b]">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
						</div>
						<div>
							<p class="text-white/60 text-sm">Events</p>
							<p class="text-white font-semibold text-2xl">{stats.totalEvents}</p>
						</div>
					</div>
					<div class="flex gap-4 text-xs">
						<span class="text-amber-400/80">{stats.pendingEvents} pending</span>
					</div>
				</a>
			</div>

			<div class="bg-[#0D3559] rounded-xl p-6 border border-white/10">
				<h2 class="text-xl font-bold text-white mb-4">Quick Actions</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					<a href="/admin/users" class="bg-white/5 hover:bg-white/10 rounded-lg p-4 border border-white/10 transition-colors no-underline block">
						<div class="flex items-center gap-3">
							<svg class="w-5 h-5 text-[#31dcb2]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0 0h1m9-4h-9m0 0V9a3 3 0 00-3-3H9a3 3 0 00-3 3v1m0 0v6a3 3 0 003 3h6a3 3 0 003-3v-6"></path></svg>
							<span class="text-white font-medium">Create New User</span>
						</div>
					</a>
					<a href="/admin/instances" class="bg-white/5 hover:bg-white/10 rounded-lg p-4 border border-white/10 transition-colors no-underline block">
						<div class="flex items-center gap-3">
							<svg class="w-5 h-5 text-[#31dcb2]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
							<span class="text-white font-medium">Review Instances</span>
						</div>
					</a>
					<a href="/admin/events" class="bg-white/5 hover:bg-white/10 rounded-lg p-4 border border-white/10 transition-colors no-underline block">
						<div class="flex items-center gap-3">
							<svg class="w-5 h-5 text-[#31dcb2]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
							<span class="text-white font-medium">Manage Events</span>
						</div>
					</a>
				</div>
			</div>
		</div>
	</main>
</Layout>
