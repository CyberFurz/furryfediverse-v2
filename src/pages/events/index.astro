---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import EventList from "../../components/EventList";
const user = Astro.locals.user;
---

<Layout title="Events - Furry Fediverse">
    <main class="p-2 md:p-5 lg:px-60 2xl:px-80">
        <div class="flex flex-col">
            <div class="flex items-center gap-2 text-sm bg-[#31dcb2] px-4 py-2 rounded-md">
                <a href="/" class="text-[#12384b] font-semibold">Home</a>
                <i class="fa-solid fa-chevron-right w-4 h-4 text-[#12384b]"></i><span class="text-[#12384b] font-semibold">Events</span>
            </div>

            <div class="py-6">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                    <div>
                        <h1 class="font-bold text-2xl text-white">Events</h1>
                        <p class="text-white/50 text-sm mt-1">
                            Furry event discussions from across the fediverse
                        </p>
                    </div>
                    {
                        user ? (
                            <a href="/events/create"
                                class="shrink-0 bg-[#31dcb2] text-[#12384b] font-semibold px-4 py-2 rounded-lg hover:bg-[#28c4a0] transition-colors text-center no-underline text-sm">
                                Create Event
                            </a>
                        ) : null
                    }
                </div>

                <EventList client:load />
            </div>
        </div>
    </main>
</Layout>
