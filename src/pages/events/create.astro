---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import CreateEvent from "../../components/CreateEvent";
const user = Astro.locals.user;

if (!user) {
    return Astro.redirect("/auth/login?redirect=/events/create");
}

if (!user.emailVerified) {
    return Astro.redirect("/auth/dashboard?unverified=1");
}
---

<Layout title="Create Event - Furry Fediverse">
    <main class="p-2 md:p-5 lg:px-60 2xl:px-80">
        <div class="flex flex-col">
            <div class="flex items-center gap-2 text-sm bg-[#31dcb2] px-4 py-2 rounded-md">
                <a href="/" class="text-[#12384b] font-semibold">Home</a>
                <i class="fa-solid fa-chevron-right w-4 h-4 text-[#12384b]"></i><a href="/events" class="text-[#12384b] font-semibold">Events</a>
                <i class="fa-solid fa-chevron-right w-4 h-4 text-[#12384b]"></i><span class="text-[#12384b] font-semibold">Create</span>
            </div>

            <div class="py-6">
                <div class="mb-6">
                    <h1 class="font-bold text-2xl text-white">Create Event</h1>
                    <p class="text-white/50 text-sm mt-1">
                        Create an event page to track Mastodon discussions
                    </p>
                </div>

                <CreateEvent client:load />
            </div>
        </div>
    </main>
</Layout>
