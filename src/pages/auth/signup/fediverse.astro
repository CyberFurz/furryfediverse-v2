---
export const prerender = false;
import Layout from "../../../layouts/Layout.astro";
import ScopeDisclosure from "../../../components/ScopeDisclosure.astro";

const user = Astro.locals.user;
if (user) {
  return Astro.redirect("/auth/dashboard");
}

const connected = Astro.url.searchParams.get("connected") === "1";
const errorCode = Astro.url.searchParams.get("error");
const errorMessages: Record<string, string> = {
  account_not_linked:
    "That fediverse account isn't registered yet. Connect it below to create your account.",
  already_linked:
    "That fediverse account is already registered. Please sign in instead.",
};
const errorText = errorCode
  ? (errorMessages[errorCode] ?? "Something went wrong. Please try again.")
  : null;
---

<Layout title="Sign Up with Fediverse - Furry Fediverse">
  <main class="flex items-center justify-center min-h-[calc(100vh-8rem)] p-4">
    <div class="w-full max-w-md">
      <div class="bg-[#0D3559] rounded-xl p-8 border border-white/10 shadow-xl">
        <h1 class="text-3xl font-bold text-white mb-2">Register</h1>
        <p class="text-white/60 mb-4">
          Connect your existing fediverse account first, then add your email.
        </p>

        <div
          class="bg-[#31dcb2]/10 border border-[#31dcb2]/30 text-white/80 px-4 py-3 rounded-lg text-sm mb-6"
        >
          <strong class="text-white"
            >This does not create a fediverse account.</strong
          >
          &nbsp; Registering here only gives you an account on Furry Fediverse for
          managing starter packs and your directory listing. You need an existing
          account on a fediverse server (Mastodon, Pixelfed, etc.) first. Don't have
          one yet? &nbsp;
          <a href="/" class="text-[#31dcb2] hover:text-[#28c4a0] font-medium"
            >Find a server to join</a
          >.
        </div>

        {
          errorText && (
            <div class="bg-red-500/20 border border-red-500/50 text-red-300 px-4 py-3 rounded-lg text-sm mb-4">
              {errorText}
            </div>
          )
        }

        <div
          id="error-message"
          class="hidden bg-red-500/20 border border-red-500/50 text-red-300 px-4 py-3 rounded-lg text-sm mb-4"
        >
        </div>
        <div
          id="success-message"
          class="hidden bg-green-500/20 border border-green-500/50 text-green-300 px-4 py-3 rounded-lg text-sm mb-4"
        >
        </div>

        <div class:list={["mb-4", connected && "hidden"]}>
          <ScopeDisclosure selectId="platform" collapsible />
        </div>

        <form
          id="connect-form"
          class:list={["space-y-4 mb-5", connected && "hidden"]}
        >
          <div>
            <label
              for="platform"
              class="block text-sm font-medium text-white/80 mb-2"
              >Platform</label
            >
            <select
              id="platform"
              class="w-full px-4 py-3 bg-white/5 border border-white/20 rounded-lg text-white"
            >
              <option value="mastodon">Mastodon</option>
              <option value="pleroma">Pleroma / Akkoma</option>
              <option value="pixelfed">Pixelfed</option>
              <option value="firefish">Firefish / Iceshrimp</option>
              <option value="gotosocial">GoToSocial</option>
            </select>
          </div>
          <div>
            <label
              for="instanceDomain"
              class="block text-sm font-medium text-white/80 mb-2"
              >Instance Domain</label
            >
            <input
              id="instanceDomain"
              type="text"
              placeholder="mastodon.social"
              required
              class="w-full px-4 py-3 bg-white/5 border border-white/20 rounded-lg text-white placeholder-white/40"
            />
          </div>
          <button
            type="submit"
            class="w-full bg-[#31dcb2] text-[#12384b] font-semibold px-6 py-3 rounded-lg"
            >Connect Fediverse Account</button
          >
        </form>

        <form
          id="finish-form"
          class:list={["space-y-4", !connected && "hidden"]}
        >
          <div>
            <label
              for="name"
              class="block text-sm font-medium text-white/80 mb-2"
              >Display Name</label
            >
            <input
              id="name"
              type="text"
              required
              class="w-full px-4 py-3 bg-white/5 border border-white/20 rounded-lg text-white"
              placeholder="Your display name"
            />
          </div>
          <div>
            <label
              for="email"
              class="block text-sm font-medium text-white/80 mb-2"
              >Email Address</label
            >
            <input
              id="email"
              type="email"
              required
              class="w-full px-4 py-3 bg-white/5 border border-white/20 rounded-lg text-white"
              placeholder="you@example.com"
            />
          </div>
          <button
            type="submit"
            class="w-full bg-[#31dcb2] text-[#12384b] font-semibold px-6 py-3 rounded-lg"
            >Create Account</button
          >
        </form>

        <p class="mt-6 text-center text-white/60 text-sm">
          Already registered? &nbsp;
          <a
            href="/auth/login"
            class="text-[#31dcb2] hover:text-[#28c4a0] no-underline font-medium"
            >Sign in</a
          >
        </p>
      </div>
    </div>
  </main>
</Layout>

<script>
  const connectForm = document.getElementById(
    "connect-form",
  ) as HTMLFormElement;
  const finishForm = document.getElementById("finish-form") as HTMLFormElement;
  const errorMessage = document.getElementById("error-message");
  const successMessage = document.getElementById("success-message");

  const showError = (msg: string) => {
    errorMessage!.textContent = msg;
    errorMessage!.classList.remove("hidden");
    successMessage!.classList.add("hidden");
  };

  connectForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const platform = (document.getElementById("platform") as HTMLSelectElement)
      .value;
    const instanceDomain = (
      document.getElementById("instanceDomain") as HTMLInputElement
    ).value.trim();

    const res = await fetch("/api/auth/link/start", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ platform, instanceDomain, flow: "register" }),
    });
    const json = await res.json();
    if (!res.ok || !json.authUrl) {
      showError(json.error || "Failed to start Fediverse OAuth");
      return;
    }
    window.location.href = json.authUrl;
  });

  finishForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const name = (
      document.getElementById("name") as HTMLInputElement
    ).value.trim();
    const email = (
      document.getElementById("email") as HTMLInputElement
    ).value.trim();
    const res = await fetch("/api/auth/fediverse-signup/complete", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ name, email }),
    });
    const json = await res.json();
    if (!res.ok) {
      showError(json.error || "Failed to complete signup");
      return;
    }
    window.location.href = "/auth/dashboard";
  });
</script>
