---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";

const user = Astro.locals.user;
const session = Astro.locals.session;

if (!user) {
	return Astro.redirect("/auth/login");
}

const userInitial = user.name?.charAt(0).toUpperCase() || "U";
const memberSince = user.createdAt
	? new Date(user.createdAt).toLocaleDateString("en-US", {
			year: "numeric",
			month: "long",
			day: "numeric",
		})
	: "Unknown";
---

<Layout title="Dashboard - Furry Fediverse">
	<main class="p-2 md:p-5 lg:px-60 2xl:px-80">
		<div class="py-8">
			<h1 class="text-3xl font-bold text-white mb-8">
				Welcome back, <span class="text-[#31dcb2]">{user.name}</span>
			</h1>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
				<div class="bg-[#0D3559] rounded-xl p-6 border border-white/10">
					<div class="flex items-center gap-4">
						<div
							class="w-12 h-12 bg-[#31dcb2] rounded-full flex items-center justify-center text-[#12384b] font-bold text-xl"
						>
							{userInitial}
						</div>
						<div>
							<p class="text-white/60 text-sm">Display Name</p>
							<p class="text-white font-semibold">{user.name}</p>
						</div>
					</div>
				</div>

				<div class="bg-[#0D3559] rounded-xl p-6 border border-white/10">
					<div class="flex items-center gap-4">
						<div
							class="w-12 h-12 bg-[#31dcb2] rounded-full flex items-center justify-center"
						>
							<svg
								class="w-6 h-6 text-[#12384b]"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
								></path>
							</svg>
						</div>
						<div>
							<p class="text-white/60 text-sm">Email</p>
							<p class="text-white font-semibold">{user.email}</p>
						</div>
					</div>
				</div>

				<div class="bg-[#0D3559] rounded-xl p-6 border border-white/10">
					<div class="flex items-center gap-4">
						<div
							class="w-12 h-12 bg-[#31dcb2] rounded-full flex items-center justify-center"
						>
							<svg
								class="w-6 h-6 text-[#12384b]"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
								></path>
							</svg>
						</div>
						<div>
							<p class="text-white/60 text-sm">Member Since</p>
							<p class="text-white font-semibold">
								{memberSince}
							</p>
						</div>
					</div>
				</div>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				<div class="bg-[#0D3559] rounded-xl p-6 border border-white/10">
					<h2 class="text-xl font-bold text-white mb-4">
						Quick Actions
					</h2>
					<div class="space-y-3">
						<a
							href="/instances/manage"
							class="block bg-white/5 hover:bg-white/10 rounded-lg p-4 border border-white/10 transition-colors no-underline"
						>
							<div class="flex items-center gap-3">
								<svg
									class="w-5 h-5 text-[#31dcb2]"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
									></path>
								</svg>
								<span class="text-white font-medium"
									>My Instances</span
								>
							</div>
						</a>
						<a
							href="/users"
							class="block bg-white/5 hover:bg-white/10 rounded-lg p-4 border border-white/10 transition-colors no-underline"
						>
							<div class="flex items-center gap-3">
								<svg
									class="w-5 h-5 text-[#31dcb2]"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
									></path>
								</svg>
								<span class="text-white font-medium"
									>My Fediverse Users</span
								>
							</div>
						</a>
						<a
							href="/learn"
							class="block bg-white/5 hover:bg-white/10 rounded-lg p-4 border border-white/10 transition-colors no-underline"
						>
							<div class="flex items-center gap-3">
								<i class="fa-solid fa-gear text-[#31dcb2]"></i>
								<span class="text-white font-medium"
									>Account Settings</span
								>
							</div>
						</a>
					</div>
				</div>

				<div class="bg-[#0D3559] rounded-xl p-6 border border-white/10">
					<h2 class="text-xl font-bold text-white mb-4">
						Account Status
					</h2>
					<div class="space-y-4">
						<div class="flex items-center justify-between">
							<span class="text-white/60">Email Verified</span>
							<span
								class="px-3 py-1 rounded-full text-sm font-medium {user.emailVerified ? 'bg-green-500/20 text-green-300' : 'bg-yellow-500/20 text-yellow-300'}"
							>
								{user.emailVerified ? "Verified" : "Pending"}
							</span>
						</div>
						<div class="flex items-center justify-between">
							<span class="text-white/60">Account ID</span>
							<span class="text-white/80 text-sm font-mono"
								>{user.id.slice(0, 8)}...</span
							>
						</div>
						<div class="pt-4 border-t border-white/10">
							<a
								href="/auth/logout"
								class="w-full bg-red-500/20 hover:bg-red-500/30 text-red-300 font-medium px-4 py-2 rounded-lg transition-colors border border-red-500/30 block text-center no-underline"
							>
								Sign Out
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>
</Layout>
