---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";

const user = Astro.locals.user;
const session = Astro.locals.session;
const blockedForUnverified = Astro.url.searchParams.get("unverified") === "1";

if (!user) {
	return Astro.redirect("/auth/login");
}

const userInitial = user.name?.charAt(0).toUpperCase() || "U";
const userImage = user.image || null;
const memberSince = user.createdAt
	? new Date(user.createdAt).toLocaleDateString("en-US", {
			year: "numeric",
			month: "long",
			day: "numeric",
		})
	: "Unknown";
---

<Layout title="Dashboard - Furry Fediverse">
	<main class="p-2 md:p-5 lg:px-60 2xl:px-80">
		<div
			class="flex items-center gap-2 text-sm bg-[#31dcb2] px-4 py-2 rounded-md"
		>
			<a href="/" class="text-[#12384b] font-semibold">Home</a>
			<svg
				class="w-4 h-4 text-[#12384b]"
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M9 5l7 7-7 7"></path>
			</svg>
			<a href="/auth/dashboard" class="text-[#12384b] font-semibold"
				>User Dashboard</a
			>
		</div>
		<div class="py-5">
			{blockedForUnverified && !user.emailVerified && (
				<div class="mb-6 bg-amber-500/15 border border-amber-400/40 text-amber-100 px-4 py-3 rounded-lg text-sm">
					Verify your email to add instances, link accounts, and write articles.
				</div>
			)}
			<h1 class="text-3xl font-bold text-white mb-8">
				Welcome back, <span class="text-[#31dcb2]">{user.name}</span>
			</h1>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
				<div class="bg-[#0D3559] rounded-xl p-6 border border-white/10">
					<div class="flex items-center gap-4">
						{
							userImage ? (
								<img
									src={userImage}
									alt={user.name}
									class="w-12 h-12 rounded-full object-cover"
								/>
							) : (
								<div class="w-12 h-12 bg-[#31dcb2] rounded-full flex items-center justify-center text-[#12384b] font-bold text-xl">
									{userInitial}
								</div>
							)
						}
						<div>
							<p class="text-white/60 text-sm">Display Name</p>
							<p class="text-white font-semibold">{user.name}</p>
						</div>
					</div>
				</div>

				<div class="bg-[#0D3559] rounded-xl p-6 border border-white/10">
					<div class="flex items-center gap-4">
						<div
							class="w-12 h-12 bg-[#31dcb2] rounded-full flex items-center justify-center"
						>
							<svg
								class="w-6 h-6 text-[#12384b]"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
								></path>
							</svg>
						</div>
						<div>
							<p class="text-white/60 text-sm">Email</p>
							<p class="text-white font-semibold">{user.email}</p>
						</div>
					</div>
				</div>

				<div class="bg-[#0D3559] rounded-xl p-6 border border-white/10">
					<div class="flex items-center gap-4">
						<div
							class="w-12 h-12 bg-[#31dcb2] rounded-full flex items-center justify-center"
						>
							<svg
								class="w-6 h-6 text-[#12384b]"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
								></path>
							</svg>
						</div>
						<div>
							<p class="text-white/60 text-sm">Member Since</p>
							<p class="text-white font-semibold">
								{memberSince}
							</p>
						</div>
					</div>
				</div>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				<div class="bg-[#0D3559] rounded-xl p-6 border border-white/10">
					<h2 class="text-xl font-bold text-white mb-4">
						Quick Actions
					</h2>
					<div class="space-y-3">
						<a
							href="/auth/links"
							class="block bg-white/5 hover:bg-white/10 rounded-lg p-4 border border-white/10 transition-colors no-underline"
						>
							<div class="flex items-center gap-3">
								<i class="fa-solid fa-user-group text-[#31dcb2]"
								></i>
								<span class="text-white font-medium"
									>My Fediverse Users</span
								>
							</div>
						</a>
						<a
							href="/instances/manage"
							class="block bg-white/5 hover:bg-white/10 rounded-lg p-4 border border-white/10 transition-colors no-underline"
						>
							<div class="flex items-center gap-3">
								<i class="fa-brands fa-fediverse text-[#31dcb2]"
								></i>
								<span class="text-white font-medium"
									>My Instances</span
								>
							</div>
						</a>
						<a
							href="/learn/my-articles"
							class="block bg-white/5 hover:bg-white/10 rounded-lg p-4 border border-white/10 transition-colors no-underline"
						>
							<div class="flex items-center gap-3">
								<i class="fa-solid fa-book-open text-[#31dcb2]"
								></i>
								<span class="text-white font-medium"
									>My Articles</span
								>
							</div>
						</a>
						<a
							href="/packs"
							class="block bg-white/5 hover:bg-white/10 rounded-lg p-4 border border-white/10 transition-colors no-underline"
						>
							<div class="flex items-center gap-3">
								<i class="fa-solid fa-rectangle-archive text-[#31dcb2]"
								></i>
								<span class="text-white font-medium"
									>My Packs</span
								>
							</div>
						</a>
						<a
							href="/auth/settings"
							class="block bg-white/5 hover:bg-white/10 rounded-lg p-4 border border-white/10 transition-colors no-underline"
						>
							<div class="flex items-center gap-3">
								<i class="fa-solid fa-gear text-[#31dcb2]"></i>
								<span class="text-white font-medium"
									>Account Settings</span
								>
							</div>
						</a>
					</div>
				</div>

				<div class="bg-[#0D3559] rounded-xl p-6 border border-white/10">
					<h2 class="text-xl font-bold text-white mb-4">
						Account Status
					</h2>
					<div class="space-y-4">
						<div class="flex items-center justify-between">
							<span class="text-white/60">Email Verified</span>
							<span
								class="px-3 py-1 rounded-full text-sm font-medium {user.emailVerified ? 'bg-green-500/20 text-green-300' : 'bg-yellow-500/20 text-yellow-300'}"
							>
								{user.emailVerified ? "Verified" : "Pending"}
							</span>
						</div>
						{!user.emailVerified && (
							<div class="space-y-2">
								<p class="text-white/60 text-sm">Didn't get the verification email?</p>
								<div id="verification-status" class="hidden text-sm px-3 py-2 rounded-lg"></div>
								<button
									type="button"
									id="resend-verification-btn"
									data-email={user.email}
									class="w-full bg-white/5 hover:bg-white/10 text-white font-medium px-4 py-2 rounded-lg transition-colors border border-white/20"
								>
									Resend verification email
								</button>
							</div>
						)}
						<div class="flex items-center justify-between">
							<span class="text-white/60">Account ID</span>
							<span class="text-white/80 text-sm font-mono"
								>{user.id.slice(0, 8)}...</span
							>
						</div>
						<div class="pt-4 border-t border-white/10">
							<a
								href="/auth/logout"
								class="w-full bg-red-500/20 hover:bg-red-500/30 text-red-300 font-medium px-4 py-2 rounded-lg transition-colors border border-red-500/30 block text-center no-underline"
							>
								Sign Out
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>
</Layout>

{!user.emailVerified && (
	<script>
		const resendButton = document.getElementById("resend-verification-btn") as HTMLButtonElement | null;
		const verificationStatus = document.getElementById("verification-status");
		const userEmail = resendButton?.getAttribute("data-email");

		resendButton?.addEventListener("click", async () => {
			if (!userEmail) {
				if (verificationStatus) {
					verificationStatus.textContent = "Unable to determine your email for verification.";
					verificationStatus.className = "text-sm px-3 py-2 rounded-lg bg-red-500/20 border border-red-500/50 text-red-300";
					verificationStatus.classList.remove("hidden");
				}
				return;
			}
			resendButton.disabled = true;
			resendButton.textContent = "Sending...";
			verificationStatus?.classList.add("hidden");

			try {
				const response = await fetch("/api/auth/send-verification-email", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ email: userEmail, callbackURL: "/auth/dashboard" }),
				});

				const contentType = response.headers.get("content-type") ?? "";
				const data = contentType.includes("application/json") ? await response.json() : null;

				if (!response.ok) {
					const message = data && typeof data === "object" && "message" in data
						? String(data.message)
						: "Unable to send verification email";
					throw new Error(message);
				}

				if (verificationStatus) {
					verificationStatus.textContent = "Verification email sent. Check your inbox.";
					verificationStatus.className = "text-sm px-3 py-2 rounded-lg bg-emerald-500/20 border border-emerald-400/40 text-emerald-200";
				}
			} catch (errorValue: unknown) {
				if (verificationStatus) {
					const message = errorValue instanceof Error ? errorValue.message : "Unable to send verification email";
					verificationStatus.textContent = message;
					verificationStatus.className = "text-sm px-3 py-2 rounded-lg bg-red-500/20 border border-red-500/50 text-red-300";
				}
			} finally {
				verificationStatus?.classList.remove("hidden");
				resendButton.disabled = false;
				resendButton.textContent = "Resend verification email";
			}
		});
	</script>
)}
