---
export const prerender = false;
import Layout from "../../../layouts/Layout.astro";

const user = Astro.locals.user;
if (user) return Astro.redirect("/auth/dashboard");
---

<Layout title="Sign In with Fediverse - Furry Fediverse">
  <main class="flex items-center justify-center min-h-[calc(100vh-8rem)] p-4">
    <div class="w-full max-w-md bg-[#0D3559] rounded-xl p-8 border border-white/10 shadow-xl">
      <h1 class="text-3xl font-bold text-white mb-2">Sign In with Fediverse</h1>
      <p class="text-white/60 mb-6">Use your linked Fediverse account to sign in.</p>
      <div id="error-message" class="hidden bg-red-500/20 border border-red-500/50 text-red-300 px-4 py-3 rounded-lg text-sm mb-4"></div>
      <form id="fedi-login-form" class="space-y-4">
        <select id="platform" class="w-full px-4 py-3 bg-white/5 border border-white/20 rounded-lg text-white">
          <option value="mastodon">Mastodon</option><option value="pleroma">Pleroma / Akkoma</option><option value="pixelfed">Pixelfed</option><option value="firefish">Firefish / Iceshrimp</option><option value="gotosocial">GoToSocial</option>
        </select>
        <input id="instanceDomain" type="text" placeholder="mastodon.social" required class="w-full px-4 py-3 bg-white/5 border border-white/20 rounded-lg text-white placeholder-white/40" />
        <button type="submit" class="w-full bg-[#31dcb2] text-[#12384b] font-semibold px-6 py-3 rounded-lg">Continue with OAuth</button>
      </form>
    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById("fedi-login-form") as HTMLFormElement;
  const errorMessage = document.getElementById("error-message");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const platform = (document.getElementById("platform") as HTMLSelectElement).value;
    const instanceDomain = (document.getElementById("instanceDomain") as HTMLInputElement).value.trim();
    const res = await fetch("/api/auth/link/start", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ platform, instanceDomain, flow: "login" }) });
    const json = await res.json();
    if (!res.ok || !json.authUrl) {
      errorMessage!.textContent = json.error || "Failed to start login";
      errorMessage!.classList.remove("hidden");
      return;
    }
    window.location.href = json.authUrl;
  });
</script>
