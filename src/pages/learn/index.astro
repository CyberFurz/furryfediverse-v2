---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import ArticleList from "../../components/ArticleList";

const user = Astro.locals.user;
---

<Layout title="Learn - Furry Fediverse">
    <main class="p-2 md:p-5 lg:px-60 2xl:px-80">
        <div class="flex flex-col">
            <div
                class="flex items-center gap-2 text-sm bg-[#31dcb2] px-4 py-2 rounded-md"
            >
                <a href="/" class="text-[#12384b] font-semibold">Home</a>
                <svg
                    class="w-4 h-4 text-[#12384b]"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"></path>
                </svg>
                <span class="text-[#12384b] font-semibold">Learn</span>
            </div>

            <div class="py-6">
                <div
                    class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6"
                >
                    <div>
                        <h1 class="font-bold text-2xl text-white">
                            Learn About the Fediverse
                        </h1>
                        <p class="text-white/50 text-sm mt-1">
                            Guides, tutorials, and resources for furry fediverse enthusiasts
                        </p>
                    </div>
                    {user ? (
                        <a
                            href="/learn/my-articles"
                            class="shrink-0 bg-[#31dcb2] text-[#12384b] font-semibold px-4 py-2 rounded-lg hover:bg-[#28c4a0] transition-colors text-center no-underline text-sm"
                        >
                            My Articles
                        </a>
                    ) : null}
                </div>

                <ArticleList client:load />
            </div>
        </div>
    </main>
</Layout>
