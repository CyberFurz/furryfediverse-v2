---
export const prerender = false;
import Layout from "../../../layouts/Layout.astro";

const user = Astro.locals.user;

if (!user) {
    return Astro.redirect("/auth/login?redirect=/learn/my-articles");
}
---

<Layout title="My Articles - Furry Fediverse">
    <main class="p-2 md:p-5 lg:px-60 2xl:px-80">
        <div class="flex flex-col">
            <div
                class="flex items-center gap-2 text-sm bg-[#31dcb2] px-4 py-2 rounded-md"
            >
                <a href="/" class="text-[#12384b] font-semibold">Home</a>
                <svg
                    class="w-4 h-4 text-[#12384b]"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"></path>
                </svg>
                <a href="/learn" class="text-[#12384b] font-semibold">Learn</a>
                <svg
                    class="w-4 h-4 text-[#12384b]"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"></path>
                </svg>
                <span class="text-[#12384b] font-semibold">My Articles</span>
            </div>

            <div class="py-6 space-y-6">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <div>
                        <h1 class="font-bold text-2xl text-white">My Articles</h1>
                        <p class="text-white/50 text-sm mt-1">Manage your article drafts</p>
                    </div>
                    <a
                        href="/learn/add"
                        class="flex-shrink-0 bg-[#31dcb2] text-[#12384b] font-semibold px-4 py-2 rounded-lg hover:bg-[#28c4a0] transition-colors text-center no-underline text-sm"
                    >
                        Write New Article
                    </a>
                </div>

                <div id="loading-state" class="flex justify-center py-16">
                    <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-[#31dcb2]"></div>
                </div>

                <div id="empty-state" class="hidden p-12 rounded-md bg-[#0D3559] border border-white/10 text-center">
                    <svg class="w-16 h-16 text-white/20 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6M7 16h6" />
                    </svg>
                    <h3 class="text-xl font-semibold text-white mb-2">No drafts yet</h3>
                    <p class="text-white/50 mb-6">Share your knowledge with the community!</p>
                    <a
                        href="/learn/add"
                        class="bg-[#31dcb2] text-[#12384b] font-semibold px-6 py-2 rounded-lg hover:bg-[#28c4a0] transition-colors no-underline inline-block"
                    >
                        Write Your First Article
                    </a>
                </div>

                <div id="articles-container" class="hidden space-y-4"></div>
            </div>
        </div>
    </main>
</Layout>

<script is:inline>
    document.addEventListener("DOMContentLoaded", function() {
        var loadingState = document.getElementById("loading-state");
        var emptyState = document.getElementById("empty-state");
        var container = document.getElementById("articles-container");

        var categoryLabels = {
            "self-hosting": "Self-Hosting",
            "how-to": "How To",
            "other": "Other"
        };

        var statusColors = {
            "draft": "bg-gray-500/20 text-gray-300 border-gray-500/50",
            "pending": "bg-amber-500/20 text-amber-300 border-amber-500/50",
            "approved": "bg-emerald-500/20 text-emerald-300 border-emerald-500/50",
            "rejected": "bg-red-500/20 text-red-300 border-red-500/50"
        };

        var statusLabels = {
            "draft": "Draft",
            "pending": "Pending Review",
            "approved": "Published",
            "rejected": "Rejected"
        };

        function formatDate(dateStr) {
            return new Date(dateStr).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
        }

        function escapeHtml(text) {
            var div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        fetch("/api/learn/my-drafts")
            .then(function(response) { return response.json(); })
            .then(function(data) {
                loadingState.classList.add("hidden");

                if (!data.drafts || data.drafts.length === 0) {
                    emptyState.classList.remove("hidden");
                    return;
                }

                container.classList.remove("hidden");

                data.drafts.forEach(function(draft) {
                    var statusColor = statusColors[draft.status] || "bg-white/10 text-white/70 border-white/30";
                    var statusLabel = statusLabels[draft.status] || draft.status;
                    var categoryLabel = categoryLabels[draft.category] || draft.category;
                    var plainText = draft.content.replace(/<[^>]*>/g, '').substring(0, 150);
                    var hasPublished = draft.article !== null;

                    var card = document.createElement("div");
                    card.className = "p-4 rounded-md bg-[#0D3559] border border-white/10";
                    card.innerHTML = '<div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">' +
                        '<div class="flex-1 min-w-0">' +
                        '<div class="flex items-center gap-2 mb-2 flex-wrap">' +
                        '<h3 class="font-bold text-white text-lg">' + escapeHtml(draft.title) + '</h3>' +
                        '<span class="text-xs px-2 py-1 rounded ' + statusColor + '">' + statusLabel + '</span>' +
                        (hasPublished ? '<span class="text-xs px-2 py-1 rounded bg-blue-500/20 text-blue-300 border border-blue-500/50">Published Version Exists</span>' : '') +
                        '</div>' +
                        '<div class="flex items-center gap-3 text-xs text-white/50 mb-2">' +
                        '<span class="px-2 py-0.5 rounded bg-white/10">' + categoryLabel + '</span>' +
                        '<span>' + formatDate(draft.createdAt) + '</span>' +
                        '</div>' +
                        '<p class="text-sm text-white/60 line-clamp-2">' + escapeHtml(plainText) + '...</p>' +
                        '</div>' +
                        '<div class="flex gap-2 flex-shrink-0 mt-3 sm:mt-0">' +
                        '<a href="/learn/my-articles/edit/' + draft.id + '" class="text-xs px-3 py-1.5 rounded bg-white/5 border border-white/20 text-white/80 hover:bg-white/10 transition-colors no-underline text-center">Edit</a>' +
                        '<button class="delete-draft-btn text-xs px-3 py-1.5 rounded bg-red-500/10 border border-red-500/30 text-red-300 hover:bg-red-500/20 transition-colors" data-id="' + draft.id + '" data-title="' + escapeHtml(draft.title) + '">Delete</button>' +
                        '</div>' +
                        '</div>';

                    container.appendChild(card);
                });

                document.querySelectorAll(".delete-draft-btn").forEach(function(btn) {
                    btn.addEventListener("click", function() {
                        var draftId = this.getAttribute("data-id");
                        var draftTitle = this.getAttribute("data-title");
                        if (confirm("Are you sure you want to delete \"" + draftTitle + "\"? This cannot be undone.")) {
                            fetch("/api/learn/articles/" + draftId, { method: "DELETE" })
                                .then(function(response) { return response.json(); })
                                .then(function(data) {
                                    if (data.success) {
                                        window.location.reload();
                                    } else {
                                        alert("Failed to delete draft: " + (data.error || "Unknown error"));
                                    }
                                })
                                .catch(function(error) {
                                    alert("Failed to delete draft: " + error.message);
                                });
                        }
                    });
                });
            })
            .catch(function(error) {
                loadingState.classList.add("hidden");
                console.error("Error loading drafts:", error);
            });
    });
</script>
