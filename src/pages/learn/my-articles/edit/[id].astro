---
export const prerender = false;
import Layout from "../../../../layouts/Layout.astro";

const user = Astro.locals.user;

if (!user) {
    return Astro.redirect("/auth/login?redirect=/learn/my-articles");
}
---

<Layout title="Edit Article - Furry Fediverse">
    <main class="p-2 md:p-5 lg:px-60 2xl:px-80">
        <div class="flex flex-col">
            <div
                class="flex items-center gap-2 text-sm bg-[#31dcb2] px-4 py-2 rounded-md"
            >
                <a href="/" class="text-[#12384b] font-semibold">Home</a>
                <svg
                    class="w-4 h-4 text-[#12384b]"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"></path>
                </svg>
                <a href="/learn" class="text-[#12384b] font-semibold">Learn</a>
                <svg
                    class="w-4 h-4 text-[#12384b]"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"></path>
                </svg>
                <a href="/learn/my-articles" class="text-[#12384b] font-semibold">My Articles</a>
                <svg
                    class="w-4 h-4 text-[#12384b]"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"></path>
                </svg>
                <span class="text-[#12384b] font-semibold">Edit</span>
            </div>

            <div class="py-6 space-y-6">
                <div class="p-6 rounded-md bg-[#0D3559] border border-white/10">
                    <h2 class="font-bold text-xl text-white mb-4">Edit Article</h2>
                    <div id="loading-state" class="p-12 text-center">
                        <div class="animate-pulse space-y-4">
                            <div class="h-8 bg-white/10 rounded w-48 mx-auto"></div>
                            <div class="h-12 bg-white/10 rounded w-full max-w-md mx-auto"></div>
                            <div class="h-12 bg-white/10 rounded w-full max-w-md mx-auto"></div>
                        </div>
                    </div>

                    <div id="not-found-state" class="hidden p-12 text-center">
                        <h3 class="font-bold text-xl text-white mb-4">Article Not Found</h3>
                        <p class="text-white/50 mb-6">This article doesn't exist or you don't have permission to edit it.</p>
                        <a href="/learn/my-articles" class="bg-[#31dcb2] text-[#12384b] font-semibold px-6 py-2 rounded-lg hover:bg-[#28c4a0] transition-colors no-underline inline-block">Back to My Articles</a>
                    </div>

                    <form id="article-form" class="hidden space-y-5">
                        <div id="form-error" class="hidden bg-red-500/20 border border-red-500/50 text-red-300 px-4 py-3 rounded-lg text-sm"></div>
                        <div id="form-success" class="hidden bg-green-500/20 border border-green-500/50 text-green-300 px-4 py-3 rounded-lg text-sm"></div>

                        <div class="bg-amber-500/10 border border-amber-500/30 rounded-lg p-4">
                            <p class="text-sm text-amber-300">
                                <strong>Note:</strong> Editing this article will submit it for review again. It will be unpublished until approved.
                            </p>
                        </div>

                        <div>
                            <label for="article-title" class="block text-sm font-medium text-white/80 mb-2">Title</label>
                            <input type="text" id="article-title" name="title" required class="w-full px-4 py-3 bg-white/5 border border-white/20 rounded-lg text-white placeholder-white/40 focus:outline-none focus:border-[#31dcb2] focus:ring-1 focus:ring-[#31dcb2] transition-colors" />
                        </div>

                        <div>
                            <label for="article-category" class="block text-sm font-medium text-white/80 mb-2">Category</label>
                            <select id="article-category" name="category" required class="w-full px-4 py-3 bg-white/5 border border-white/20 rounded-lg text-white focus:outline-none focus:border-[#31dcb2] focus:ring-1 focus:ring-[#31dcb2] transition-colors appearance-none">
                                <option value="" class="bg-[#0A2B49]">Select category</option>
                                <option value="self-hosting" class="bg-[#0A2B49]">Self-Hosting</option>
                                <option value="how-to" class="bg-[#0A2B49]">How To</option>
                                <option value="other" class="bg-[#0A2B49]">Other</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-white/80 mb-2">Content</label>
                            <div id="editor-container" class="bg-white rounded-lg"></div>
                        </div>

                        <div class="flex gap-3">
                            <button type="submit" id="submit-btn" class="bg-[#31dcb2] text-[#12384b] font-semibold px-6 py-3 rounded-lg hover:bg-[#28c4a0] transition-colors disabled:opacity-50 disabled:cursor-not-allowed">Submit for Review</button>
                            <a href="/learn/my-articles" class="bg-white/10 text-white font-semibold px-6 py-3 rounded-lg hover:bg-white/20 transition-colors border border-white/20 no-underline text-center">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
</Layout>

    <script is:inline>
    document.addEventListener("DOMContentLoaded", function() {
        var pathParts = window.location.pathname.split("/");
        var draftId = pathParts[pathParts.length - 1];

        var loadingState = document.getElementById("loading-state");
        var notFoundState = document.getElementById("not-found-state");
        var articleForm = document.getElementById("article-form");
        var formError = document.getElementById("form-error");
        var formSuccess = document.getElementById("form-success");
        var submitBtn = document.getElementById("submit-btn");

        var script = document.createElement("script");
        script.src = "https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js";
        script.onload = function() {
            var quill = new Quill("#editor-container", {
                theme: "snow",
                placeholder: "Write your article content here...",
                modules: {
                    toolbar: [
                        [{ header: [1, 2, 3, false] }],
                        ["bold", "italic", "underline", "strike"],
                        [{ color: [] }, { background: [] }],
                        [{ list: "ordered" }, { list: "bullet" }],
                        [{ align: [] }],
                        ["blockquote", "code-block"],
                        ["link", "image"],
                        ["clean"]
                    ]
                }
            });

            fetch("/api/learn/articles/" + draftId)
                .then(function(response) { return response.json(); })
                .then(function(data) {
                    if (data.draft && data.draft.authorId) {
                        document.getElementById("article-title").value = data.draft.title;
                        document.getElementById("article-category").value = data.draft.category;
                        quill.root.innerHTML = data.draft.content;
                        loadingState.classList.add("hidden");
                        articleForm.classList.remove("hidden");
                    } else {
                        loadingState.classList.add("hidden");
                        notFoundState.classList.remove("hidden");
                    }
                })
                .catch(function() {
                    loadingState.classList.add("hidden");
                    notFoundState.classList.remove("hidden");
                });

            articleForm.addEventListener("submit", function(e) {
                e.preventDefault();

                var title = document.getElementById("article-title").value.trim();
                var category = document.getElementById("article-category").value;
                var content = quill.root.innerHTML.trim();

                if (!title) {
                    formError.textContent = "Title is required";
                    formError.classList.remove("hidden");
                    return;
                }

                if (quill.getText().trim().length < 10) {
                    formError.textContent = "Content must be at least 10 characters";
                    formError.classList.remove("hidden");
                    return;
                }

                submitBtn.disabled = true;
                submitBtn.textContent = "Submitting...";
                formError.classList.add("hidden");
                formSuccess.classList.add("hidden");

                fetch("/api/learn/articles/" + draftId, {
                    method: "PUT",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ title: title, content: content, category: category }),
                })
                .then(function(response) { return response.json(); })
                .then(function(data) {
                    if (data.success) {
                        formSuccess.textContent = "Draft updated and submitted for review!";
                        formSuccess.classList.remove("hidden");
                        setTimeout(function() {
                            window.location.href = "/learn/my-articles";
                        }, 2000);
                    } else {
                        throw new Error(data.error || "Failed to update draft");
                    }
                })
                .catch(function(error) {
                    formError.textContent = error.message || "An unexpected error occurred";
                    formError.classList.remove("hidden");
                })
                .finally(function() {
                    submitBtn.disabled = false;
                    submitBtn.textContent = "Submit for Review";
                });
            });
        };
        document.head.appendChild(script);
    });
</script>
