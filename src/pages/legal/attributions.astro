---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
---

<Layout title="License Attributions | Furry Fediverse">
    <main class="p-2 md:p-5 lg:px-60 2xl:px-80">
        <div class="flex flex-col">
            <div
                class="flex items-center gap-2 text-sm bg-[#31dcb2] px-4 py-2 rounded-md"
            >
                <a href="/" class="text-[#12384b] font-semibold">Home</a>
                <svg
                    class="w-4 h-4 text-[#12384b]"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"></path>
                </svg>
                <span class="text-[#12384b] font-semibold">Legal</span>
                <svg
                    class="w-4 h-4 text-[#12384b]"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"></path>
                </svg>
                <span class="text-[#12384b] font-semibold">Attributions</span>
            </div>

            <div class="py-6 max-w-4xl">
                <h1 class="font-bold text-2xl text-white">Open License Attributions</h1>
                <p class="text-white/50 text-sm mt-1">
                    Acknowledgement of open-source licenses used by this project
                </p>

                <div class="mt-6 bg-white/5 rounded-xl p-6 border border-white/10">
                    <p class="text-white/80 leading-relaxed">
                        This project uses open-source software distributed under
                        permissive and open licenses. We acknowledge and
                        appreciate the maintainers and contributors whose work
                        powers this site.
                    </p>
                </div>

                <div class="mt-4 bg-white/5 rounded-xl p-6 border border-white/10">
                    <h2 class="font-bold text-xl text-white mb-3">Usage terms</h2>
                    <ul class="list-disc pl-6 space-y-2 text-white/80">
                        <li>Dependencies are used according to each package's license terms.</li>
                        <li>Attribution and copyright notices remain with their respective projects.</li>
                        <li>No ownership is claimed over third-party packages used in this project.</li>
                    </ul>
                </div>

                <div class="mt-4 bg-white/5 rounded-xl p-6 border border-white/10">
                    <h2 class="font-bold text-xl text-white mb-3">Verification source</h2>
                    <p class="text-white/80 leading-relaxed">
                        The authoritative license text for each dependency is provided
                        by the dependency itself, such as each package's
                        <code>LICENSE</code> file and package metadata. If there is
                        any conflict between this page and an upstream package license,
                        the upstream package license controls.
                    </p>
                </div>

                <div class="mt-4 bg-white/5 rounded-xl p-6 border border-white/10">
                    <h2 class="font-bold text-xl text-white mb-3">Project repositories</h2>
                    <ul class="list-disc pl-6 space-y-2 text-white/80">
                        <li>
                            Astro -
                            <a
                                href="https://github.com/withastro/astro"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-[#31dcb2] hover:underline"
                            >https://github.com/withastro/astro</a
                            >
                        </li>
                        <li>
                            Prisma -
                            <a
                                href="https://github.com/prisma/prisma"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-[#31dcb2] hover:underline"
                            >https://github.com/prisma/prisma</a
                            >
                        </li>
                        <li>
                            TanStack Query -
                            <a
                                href="https://github.com/TanStack/query"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-[#31dcb2] hover:underline"
                            >https://github.com/TanStack/query</a
                            >
                        </li>
                        <li>
                            Megalodon -
                            <a
                                href="https://github.com/h3poteto/megalodon"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-[#31dcb2] hover:underline"
                            >https://github.com/h3poteto/megalodon</a
                            >
                        </li>
                        <li>
                            Font Awesome -
                            <a
                                href="https://github.com/FortAwesome/Font-Awesome"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-[#31dcb2] hover:underline"
                            >https://github.com/FortAwesome/Font-Awesome</a
                            >
                        </li>
                        <li>
                            Tailwind CSS -
                            <a
                                href="https://github.com/tailwindlabs/tailwindcss"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-[#31dcb2] hover:underline"
                            >https://github.com/tailwindlabs/tailwindcss</a
                            >
                        </li>
                        <li>
                            Nodemailer -
                            <a
                                href="https://github.com/nodemailer/nodemailer"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-[#31dcb2] hover:underline"
                            >https://github.com/nodemailer/nodemailer</a
                            >
                        </li>
                        <li>
                            better-auth -
                            <a
                                href="https://github.com/better-auth/better-auth"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-[#31dcb2] hover:underline"
                            >https://github.com/better-auth/better-auth</a
                            >
                        </li>
                        <li>
                            Vite -
                            <a
                                href="https://github.com/vitejs/vite"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-[#31dcb2] hover:underline"
                            >https://github.com/vitejs/vite</a
                            >
                        </li>
                        <li>
                            React -
                            <a
                                href="https://github.com/facebook/react"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-[#31dcb2] hover:underline"
                            >https://github.com/facebook/react</a
                            >
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </main>
</Layout>
